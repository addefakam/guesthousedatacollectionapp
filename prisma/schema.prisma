// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  password       String
  name           String
  role           String   @default("COLLECTOR") // ADMIN or COLLECTOR
  assignedSubCity String? // sub-city assignment for collectors
  assignedArea   String?  // woreda/area assignment for collectors
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attendances Attendance[]
}

model GuestHouse {
  id               String   @id @default(cuid())
  guestHouseName   String
  organizationName String?
  subCity          String
  area             String
  specificAddress  String
  numberOfRooms    Int
  licenseType      String
  licenseLevel     String
  licenseNumber    String?
  serviceRating    Int
  contactPhone     String?
  contactName      String?
  contactPhone2    String?
  contactName2     String?
  ownerName        String?
  hasRestaurant    Boolean  @default(false)
  hasParking       Boolean  @default(false)
  hasWiFi          Boolean  @default(false)
  hasHotWater      Boolean  @default(false)
  additionalServices String?
  surveyorName     String?
  surveyorId       String?
  signature        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendances Attendance[]
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
}

model Attendance {
  id           String   @id @default(cuid())
  meetingId    String
  guestHouseId String
  collectorId  String
  status       String   @default("ABSENT") // PRESENT or ABSENT
  markedAt     DateTime @updatedAt

  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  guestHouse GuestHouse @relation(fields: [guestHouseId], references: [id], onDelete: Cascade)
  collector  User       @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([meetingId, guestHouseId]) // one attendance record per guest house per meeting
}
